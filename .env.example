# Copy to .env.local and fill in. Leave the Supabase values empty to run in
# DEMO MODE (in-memory sample data, development only).

# ── Supabase (Project Settings > API) ───────────────────────────────────────
# Local CLI values are printed by `npm run db:start`.
NEXT_PUBLIC_SUPABASE_URL=
# The "anon"/"publishable" key. Safe for the browser; access is enforced by RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY. Used for rate limiting and `npm run seed`. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ── App ─────────────────────────────────────────────────────────────────────
# Public URL of this site (used in emails and redirects).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Only addresses on this domain can register. Must match
# private.allowed_email_domains in the database (see README).
NEXT_PUBLIC_ALLOWED_EMAIL_DOMAIN=eastdelta.edu.bd
